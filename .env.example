# Copy to `.env` and fill in from the Supabase dashboard (Settings -> API Keys).
#
# Both of these ship in the browser bundle, which is expected and safe: the
# publishable key grants nothing on its own, and row-level security is what
# enforces access. Never put a `secret` or `service_role` key in this file.

VITE_SUPABASE_URL=https://your-project.supabase.co

# Either name works — Supabase's own snippets use both depending on whether you
# copy the new publishable key or the legacy anon key.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
